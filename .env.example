# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.
POSTGRES_DB=medicina_mvp
POSTGRES_USER=medicina_dev
POSTGRES_PASSWORD=replace_local_password
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/medicina_mvp
SPRING_DATASOURCE_USERNAME=medicina_dev
SPRING_DATASOURCE_PASSWORD=replace_local_password

# Origen permitido por CORS (servidor de desarrollo de Angular)
FRONTEND_ORIGIN=http://localhost:4200
# URL de la API a la que el proxy de Angular reenvía /api
API_BASE_URL=http://localhost:8080/api/v1

# Cargar artículos y cuentas de demostración (db/demo). Usa "false" fuera de desarrollo.
APP_DEMO_DATA=true
# Permitir que el usuario elija su tier al registrarse. Sólo para pruebas locales.
APP_REGISTRATION_ALLOW_TIER_SELECTION=true
# Usa "true" cuando la aplicación se sirva por HTTPS.
SESSION_COOKIE_SECURE=false

# Panel administrativo
# Días desde el último acceso para considerar «activo» a un usuario.
APP_ADMIN_ACTIVE_USER_DAYS=30
# Meses de vigencia de la fecha de revisión de un artículo y días de aviso previo.
APP_ADMIN_REVIEW_VALIDITY_MONTHS=24
APP_ADMIN_REVIEW_WARNING_DAYS=60
# Horas de vigencia de los enlaces de invitación y restablecimiento de acceso.
APP_ADMIN_ACCESS_LINK_HOURS=72
# Primer SUPER_ADMIN fuera del entorno demo: sólo se aplica si no existe ninguno activo.
# Contraseña de 12 caracteres o más. Retira ambas variables después del primer arranque.
APP_BOOTSTRAP_SUPERADMIN_EMAIL=
APP_BOOTSTRAP_SUPERADMIN_PASSWORD=
